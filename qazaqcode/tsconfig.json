{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-a/types/**/*.ts",
    ".next-b/types/**/*.ts",
    ".next-m/types/**/*.ts",
    ".next-t/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-f/types/**/*.ts"
  ],
  "exclude": [
    ".next-*",
    "db",
    "e2e",
    "node_modules"
  ]
}
