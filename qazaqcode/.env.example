# QazaqCode Platform: орта айнымалылары (үлгі). Нақты мәндерді .env.local-ға жазыңыз, ҒИТ-ке жарияламаңыз.

# PostgreSQL (Supabase: Project Settings -> Database -> Connection string (pooler, транзакция режимі))
DATABASE_URL=postgresql://postgres:password@localhost:5432/qazaqcode

# Аутентификация драйвері: "local" (тек әзірлеу/тест) не "supabase" (өндіріс)
AUTH_DRIVER=local
# Сессия JWT құпиясы (local драйвері): кемінде 32 символ, кездейсоқ
AUTH_JWT_SECRET=change-me-to-a-long-random-string-32chars-min

# AUTH_DRIVER=supabase болғанда ғана:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# service_role кілті бұл қосымшада ҚАЖЕТ ЕМЕС және клиентке ешқашан берілмейді

# Қосымшаның жария мекенжайы (шақыру сілтемелері үшін)
APP_URL=http://localhost:3000
# Cookie тек HTTPS-пен: өндірісте true
COOKIE_SECURE=false

# Жария бетте "Демо сұрау" батырмасы үшін байланыс e-mail (бос болса батырма көрсетілмейді)
CONTACT_EMAIL=

# ---- Өндіріс қатаңдатуы (3-кезең) ----
# Сенімді reverse proxy саны. Rate limit клиент IP-ін X-Forwarded-For-дың ОҢ жағынан алады: 1 = Caddy/nginx; Cloudflare+nginx = 2.
# Қосымша порты тек proxy-ге ашық болуы және proxy X-Forwarded-For/Host-ты қайта жазуы тиіс (docs/DEPLOY.md).
TRUSTED_PROXY_HOPS=1
# NODE_ENV=production кезінде сервер ТӨМЕНДЕГІЛЕР орындалмаса іске қосылмайды: JWT құпиясы әлсіз емес (>=32 кездейсоқ символ),
# COOKIE_SECURE=true, APP_URL https://, AUTH_DRIVER=supabase. Генерация: openssl rand -base64 48
# ТЕК тест/демо ортасы үшін (өндірісте ЕШҚАШАН): ALLOW_LOCAL_AUTH_IN_PRODUCTION=yes, RATE_LIMIT_DISABLED=yes

# docker compose (профиль localdb / tools)
# POSTGRES_PASSWORD=
# MIGRATE_DATABASE_URL=postgresql://<иесі>:...@host/db     # миграция/backup үшін иесі рөлі (қосымша рөлінен бөлек)
# BACKUP_PASSPHRASE_FILE=./secrets/backup_passphrase       # chmod 600, git-ке салмаңыз
# BACKUP_SCHEMAS=public
# BACKUP_KEEP_DAYS=14
